# Salin ke .env lalu isi. Jangan pernah commit file .env.
CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'

# Database (Supabase: Connect > Session pooler)
database.default.hostname = ISI_HOST_POOLER
database.default.database = postgres
database.default.username = kuliner_api.ISI_KODE_PROJECT
database.default.password = ISI_PASSWORD
database.default.DBDriver = Postgre
database.default.port = 5432

# Kunci aplikasi
API_KEYS = ISI_KUNCI_API_BEBAS
JWT_SECRET = ISI_ACAK_PANJANG
JWT_TTL = 7200
CORS_ORIGINS = http://localhost:8080
RATE_AUTH = 20
RATE_UMUM = 240

# Integrasi API Hotel (Singgah Medan)
HOTEL_API_URL = https://contoh-api-hotel.example.com/api
HOTEL_API_VERIFY = true
